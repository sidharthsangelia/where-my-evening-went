generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EntryStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id        String    @id
  email     String    @unique
  name      String
  timezone  String    @default("UTC")
  aiOptIn   Boolean   @default(false)
  aiOptInAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  entries   Entry[]

  @@index([email])
}

model Entry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  audioUrl String
  imageUrl String?
  userMood String? // user selected

  vibe      String? // AI detected
  alignment String? // aligned | mixed | contrasting

  durationSeconds Int?
  fileSize        Int?

  transcript String?
  insight    String?
  pattern    String?
  themes     String[]

  status EntryStatus @default(UPLOADED)

  tokensUsed   Int?
  processedAt  DateTime?
  errorMessage String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
