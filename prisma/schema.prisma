generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id 
  email     String    @unique
  name      String
  timezone  String    @default("UTC")
  aiOptIn   Boolean   @default(false)
  aiOptInAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  entries   Entry[] // 
}

model Entry {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audioUrl   String
  imageUrl   String?
  mood       String?
  transcript String?
  aiAllowed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt 

  @@index([userId])
}
