generator client {
  provider = "prisma-client-js" // ✅ Changed from "prisma-client"
  output   = "../app/generated/prisma" // ✅ Added /client subfolder
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  timezone  String    @default("UTC")
  aiOptIn   Boolean   @default(false)
  aiOptInAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  entries   Entry[] // ✅ Renamed from 'entry' to 'entries' (convention)
}

model Entry {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade) // ✅ Added onDelete
  audioUrl   String
  imageUrl   String?
  mood       String?
  transcript String?
  aiAllowed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt // ✅ Added updatedAt

  @@index([userId])
}
